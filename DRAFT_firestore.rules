rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint: Comment
    function isValidComment(data) {
      return data.keys().hasAll([
          'postId',
          'authorUid',
          'authorName',
          'authorPhotoUrl',
          'content',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'postId',
          'authorUid',
          'authorName',
          'authorPhotoUrl',
          'content',
          'createdAt'
        ]) &&
        data.postId is int &&
        data.postId > 0 &&
        data.postId <= 1000000 &&
        data.authorUid is string &&
        isValidId(data.authorUid) &&
        data.authorUid == request.auth.uid &&
        data.authorName is string &&
        data.authorName.size() >= 2 &&
        data.authorName.size() <= 80 &&
        data.authorPhotoUrl is string &&
        data.authorPhotoUrl.size() <= 500 &&
        data.content is string &&
        data.content.size() >= 3 &&
        data.content.size() <= 1500 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: NewsletterSubscription (Isolated PII)
    function isValidSubscription(data) {
      return data.keys().hasAll([
          'userUid',
          'email',
          'displayName',
          'notifyNewArticles',
          'preferredPillar',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userUid',
          'email',
          'displayName',
          'notifyNewArticles',
          'preferredPillar',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userUid is string &&
        isValidId(data.userUid) &&
        data.userUid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 160 &&
        data.email == request.auth.token.email &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.notifyNewArticles is bool &&
        data.preferredPillar is string &&
        data.preferredPillar.size() >= 1 &&
        data.preferredPillar.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Public Article Comments Collection
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && existing().postId is int && existing().postId > 0;
      allow list: if existing().postId is int && existing().postId > 0;
      allow create: if isVerifiedUser() &&
        isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() &&
        isValidId(commentId) &&
        existing().authorUid == request.auth.uid;
    }

    // Isolated PII Newsletter Subscriptions Collection
    match /newsletter_subscriptions/{userId} {
      allow get: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidSubscription(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidSubscription(incoming()) &&
        incoming().userUid == existing().userUid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'notifyNewArticles',
          'preferredPillar',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId;
    }
  }
}
