# GEMINI_API_KEY: Optional server-side Gemini key injected by AI Studio if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / SITE_URL: Public canonical URL of the blog portal (e.g. https://achartemas.com).
APP_URL="https://achartemas.com"
SITE_URL="https://achartemas.com"

# Google AdSense (configure real publisher ID without placeholders)
# Example: ca-pub-1234567890123456
VITE_ADSENSE_CLIENT_ID=""
ADSENSE_PUBLISHER_ID=""
VITE_ADSENSE_SLOT_LEADERBOARD=""
VITE_ADSENSE_SLOT_IN_ARTICLE=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_MULTIPLEX=""

# Google Analytics 4 (Measurement ID, e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=""

# Shopee Affiliate Sub-ID / UTM Campaign Tag (optional)
VITE_SHOPEE_AFFILIATE_TAG="achartemas"
VITE_SHOPEE_STORE_URL=""

# Newsletter Email Dispatch (Resend API on server only - never expose to browser)
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL="Achar Temas <newsletter@achartemas.com>"
